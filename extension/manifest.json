{
  "manifest_version": 3,
  "name": "HireLane",
  "version": "1.1.0",
  "description": "AI-powered job application autofill and tracking",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:5000/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.greenhouse.io/*",
    "*://*.internshala.com/*",
    "*://*.naukri.com/*",
    "*://wellfound.com/*",
    "*://*.wellfound.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.greenhouse.io/*",
        "*://*.internshala.com/*",
        "*://*.naukri.com/*",
        "*://wellfound.com/*",
        "*://*.wellfound.com/*"
      ],
      "js": ["content/detector.js", "content/extractor.js", "content/filler.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}